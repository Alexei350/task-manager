# URL da API Backend
# Para desenvolvimento local, geralmente roda na porta 30000
VITE_API_BASE_URL=http://localhost:30000

# Configuração do Google OAuth
# Obtenha seu Client ID no Google Cloud Console: https://console.cloud.google.com/
# Necessário para o funcionamento do botão "Entrar com Google"
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
