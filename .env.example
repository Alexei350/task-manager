# ==========================================
# TASK MANAGER - Environment Variables
# ==========================================
# IMPORTANTE: Este arquivo é um EXEMPLO apenas!
# NUNCA commitar .env com valores reais em um repositório
# Crie um .env local baseado neste arquivo para desenvolvimento
# ==========================================

# ========== Database Configuration ==========
# Configuração do PostgreSQL
POSTGRES_USER=task_manager_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DATABASE=task_manager

# Database Host
# Para desenvolvimento local (sem Docker): localhost
# Para Docker (containers): task-manager-database
DB_HOST=task-manager-database
DB_PORT=5432
DB_NAME=task_manager
DB_USER=task_manager_user
# NOTE: DB_PASS deve ser configurada via variável de ambiente, não em .env em produção
# Use User Secrets em desenvolvimento: dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."

# ========== JWT Configuration ==========
# Chave para assinar tokens JWT
# Use uma chave aleatória e segura de pelo menos 32 caracteres
# Para gerar: `openssl rand -base64 32`
JWT_KEY=your_secret_jwt_key_here_min_32_chars

# ========== API Configuration ==========
# URL da API (para o frontend)
VITE_API_BASE_URL=http://task-manager-api:8080

# API Key para servidor MCP (se aplicável)
API_KEY=tm_sk_your_api_key_here
API_URL=https://seu-dominio.com.br

# ========== Google OAuth Configuration ==========
# Obtenha seu Client ID no Google Cloud Console: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ========== Environment Mode ==========
ASPNETCORE_ENVIRONMENT=Development